# Go server configuration references; see server/README.md.
# The executable does not automatically load dotenv files. Supply environment
# variables explicitly using your local runtime. Empty optional values retain
# the server defaults. Never commit a populated copy or secret file.

# Required runtime configuration: use a local PostgreSQL DSN and a stable private
# 0600 file containing at least 32 secret bytes. Supply at least one provider ID.
# Values are deliberately absent; these names do not register external services.
PSY_DATABASE_DSN=
PSY_TOKEN_SECRET_FILE=
PSY_GOOGLE_CLIENT_ID=
PSY_APPLE_CLIENT_ID=

# Optional browser OAuth: only use previously registered redirects. Provider
# secrets are file references, never literal credentials in this environment.
PSY_OAUTH_STEAM_REDIRECT_URI=
PSY_OAUTH_DIRECT_REDIRECT_URI=
PSY_GOOGLE_CLIENT_SECRET_FILE=
PSY_APPLE_CLIENT_SECRET_FILE=

# Optional trusted content: manifest paths are comma-separated, relative to the
# server process working directory. Certified outcomes require both path and pin.
PSY_CATALOG_MANIFESTS=
PSY_OUTCOME_CATALOG_PATH=
PSY_OUTCOME_CATALOG_SHA256=
PSY_OUTCOME_REVOKED_PROOFS=

# Optional local operation; default listener is 127.0.0.1:8080.
PSY_LISTEN_ADDR=
PSY_DATABASE_POOL_MIN=
PSY_DATABASE_POOL_MAX=
PSY_HTTP_MAX_IN_FLIGHT=
PSY_LOG_LEVEL=
PSY_LOG_MODE=
